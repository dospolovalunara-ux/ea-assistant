# Строка подключения к PostgreSQL 16
DATABASE_URL=postgres://exec_ai:exec_ai_dev@localhost:5432/executive_ai
# Отдельная база для автотестов (будет очищаться!)
TEST_DATABASE_URL=postgres://exec_ai:exec_ai_dev@localhost:5432/executive_ai_test
# Пароль демо-пользователей при запуске seed (только вымышленные данные)
SEED_DEMO_PASSWORD=
# Часовой пояс по умолчанию
APP_TIMEZONE=Asia/Almaty
# Адрес приложения (нужен для OAuth redirect URI)
APP_URL=http://localhost:3000
# Ключ шифрования OAuth-токенов и секретов MFA: 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Предыдущий ключ — только на время ротации
APP_ENCRYPTION_KEY_PREVIOUS=
# Ключ подписи короткоживущих ссылок на файлы (любая длинная случайная строка)
FILE_SIGNING_KEY=
# Приватное хранилище файлов (вне public). По умолчанию ./storage
FILE_STORAGE_DIR=
# Фоновый планировщик напоминаний внутри приложения (false — выключить)
SCHEDULER_ENABLED=true
# Google Calendar (тестовый проект Google Cloud). Только на сервере.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AI выключен до согласования провайдера. Включить: AI_PROVIDER=anthropic + ANTHROPIC_API_KEY
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Хранилище файлов: disk (по умолчанию) или db — для хостинга без постоянного диска (Vercel)
FILE_STORAGE=
# Планировщик на хостинге без постоянного процесса: on-request (проход после запросов, не чаще раза в минуту)
SCHEDULER_MODE=
# Секрет для /api/cron/tick (Vercel Cron)
CRON_SECRET=
